{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://smartcv-backend-7kp2.onrender.com/api/$1"
    },
    {
      "source": "/oauth/(.*)",
      "destination": "https://smartcv-backend-7kp2.onrender.com/oauth/$1"
    },
    {
      "source": "/preview/(.*)",
      "destination": "https://smartcv-backend-7kp2.onrender.com/preview/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
