# Vercel Deployment Environment Variables
# These variables should be configured in the Vercel Dashboard

# Backend URL (used for direct links like PDF downloads that bypass Axios)
# Note: Axios API calls are routed through Vercel's Edge Network via vercel.json proxy
VITE_BACKEND_URL=https://smartcv-backend-7kp2.onrender.com

# Frontend Application URL (useful for OAuth redirects or share links)
# Update this with your actual Vercel domain once generated (e.g. https://smartcv-user.vercel.app)
VITE_APP_URL=https://smartcv-user.vercel.app
